RADAR_DB_HOST={{ hostvars[groups['role_db'][0]]['private_ip'] }}
RADAR_DB_NAME=radar
RADAR_DB_USER=radar
RADAR_DB_PASSWORD={{ radar_db_password }}
RADAR_CENTER_LAT={{ radar_center_lat | default('59.5') }}
RADAR_CENTER_LON={{ radar_center_lon | default('18.0') }}
RADAR_RANGE_KM={{ radar_range_km | default('150') }}
RADAR_MAX_AIRCRAFT={{ radar_max_aircraft | default('10') }}
RADAR_TICK_SECONDS=5
RADAR_SPEED_MULTIPLIER={{ radar_speed_multiplier | default('12') }}
